# Supabase -> Project Settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# AI-перевод контента на EN / DE (кнопка «Обновить перевод»). Только сервер — без NEXT_PUBLIC_.
OPENAI_API_KEY=sk-...
# необязательно: модель (по умолчанию gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini

# Email-уведомления (миграция 0014). Только сервер — без NEXT_PUBLIC_.
# Supabase → Project Settings → API Keys → service_role (секретный!)
SUPABASE_SERVICE_ROLE_KEY=
# Отправитель: адрес на домене, подтверждённом в почтовом сервисе
EMAIL_FROM=Planmaneger <noreply@example.com>
# Один из двух сервисов: resend.com или brevo.com
BREVO_API_KEY=
# Секрет для /api/cron/notify (тот же — в supabase/cron_notify.sql)
CRON_SECRET=
# необязательно: адрес планера в ссылках писем, задержка сводки, часовой пояс времени в письмах
# APP_URL=https://planmaneger.vercel.app
# NOTIFY_DELAY_MINUTES=10
# NOTIFY_TIMEZONE=Europe/Kyiv
